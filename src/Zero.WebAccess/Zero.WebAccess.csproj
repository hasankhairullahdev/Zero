<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Zero.WebAccess</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting"         Version="10.0.0-preview.5.25277.114" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0-preview.5.25277.114" />
    <PackageReference Include="ModelContextProtocol"                 Version="0.3.0-preview.2" />
    <!-- HTML parsing for fetch_page -->
    <PackageReference Include="HtmlAgilityPack"                      Version="1.11.72" />
    <!-- RSS parsing for read_rss -->
    <PackageReference Include="System.ServiceModel.Syndication"      Version="9.0.5" />
  </ItemGroup>

</Project>
